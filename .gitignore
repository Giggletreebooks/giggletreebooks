.DS_Store

# Book interiors: 2.1GB of full page scans. Anything under public/ is published
# to the open web, so keeping these out of the repo prevents giving the books
# away for free (and blows past the 1GB GitHub Pages limit). Master copies live
# in Documents/GT.
website/public/series/

# Design reference clips. Local inspiration only — other people's work, kept on
# this machine and never published, committed or pushed. Ignored rather than
# just left untracked because the folder sits inside the repo, and one
# `git add -A` would otherwise sweep it in.
reference-video/
